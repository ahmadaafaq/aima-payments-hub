{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/pay",
      "destination": "/api"
    },
    {
      "source": "/api/pay",
      "destination": "/api"
    },
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/checkout/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/payments/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/payments",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api|pay).*)",
      "destination": "/index.html"
    }
  ]
}
