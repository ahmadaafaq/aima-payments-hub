# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, gateway return URLs, and webhook callbacks.
APP_URL="http://localhost:3000"

# SERVER_PORT: Port for Express server (defaults to 3000 in AI Studio)
PORT="3000"

# ==============================================================================
# WORLDLINE / PAYNIMO SANDBOX CONFIGURATION
# Reference: https://www.paynimo.com/paynimocheckout/docs/#online
# ==============================================================================
# Environment: Must be 'sandbox' (server strictly refuses 'production' in test mode)
WORLDLINE_ENVIRONMENT="sandbox"

# Merchant Code supplied in AIMA test kit
WORLDLINE_MERCHANT_CODE="T945221"

# Scheme Code supplied in AIMA test kit (maps to item.itemId)
WORLDLINE_SCHEME_CODE="FIRST"

# Worldline Secret Salt for SHA-256 token generation and dual verification
# (Provided by Worldline integration team; never expose to frontend or git)
WORLDLINE_SALT="YOUR_WORLDLINE_SANDBOX_SALT"

# ==============================================================================
# CCAVENUE / HDFC SANDBOX CONFIGURATION
# Note: The supplied correspondence contains LIVE production keys (TID 76098022,
# ACCT ID 4168947, secure.ccavenue.com), which cannot be used for sandbox.
# Acquire test credentials from test.ccavenue.com before configuring below.
# ==============================================================================
CCAVENUE_ENVIRONMENT="sandbox"
CCAVENUE_MERCHANT_ID="YOUR_CCAVENUE_TEST_MERCHANT_ID"
CCAVENUE_ACCESS_CODE="YOUR_CCAVENUE_TEST_ACCESS_CODE"
CCAVENUE_WORKING_KEY="YOUR_CCAVENUE_TEST_WORKING_KEY"

# ==============================================================================
# PHASE 3 — SOURCE APPLICATION INTEGRATION
# ==============================================================================

# ADMIN_TOKEN: Bearer token for administrative operations (application registry,
# notification management, key rotation). Must be kept secret.
ADMIN_TOKEN="aima-admin-dev-token-2026"

# SSRF_ALLOWED_PRIVATE_HOSTS: Comma-separated list of private hostnames/IPs
# that are explicitly permitted as notification endpoints. ADMIN-ONLY.
# Example: "internal-app.mylan.local,192.168.1.50"
# Leave empty for default (block all private/loopback)
SSRF_ALLOWED_PRIVATE_HOSTS=""

# ── Demo Source Application API Keys (Phase 3 Sandbox) ────────────────────────
# These are the raw API keys for each seeded AIMA source application.
# In production: deliver securely to each app team and store only the hash.
# These keys correspond to the seeded demo applications in sourceApplications.ts

# MAT — Management Aptitude Test
DEMO_MAT_API_KEY="aima_mat_demo_key_phase3_sandbox_2026"

# CME — Centre for Management Education
DEMO_CME_API_KEY="aima_cme_demo_key_phase3_sandbox_2026"

# CASE_LEAGUE — AIMA Case League
DEMO_CASE_LEAGUE_API_KEY="aima_case_league_demo_key_phase3_sandbox_2026"

# UGAT — Undergraduate Aptitude Test
DEMO_UGAT_API_KEY="aima_ugat_demo_key_phase3_sandbox_2026"

# LMA — Local Management Association
DEMO_LMA_API_KEY="aima_lma_demo_key_phase3_sandbox_2026"

# AIMA_VCC — Virtual Corporate Council
DEMO_VCC_API_KEY="aima_vcc_demo_key_phase3_sandbox_2026"

# AMT — Advanced Management Training
DEMO_AMT_API_KEY="aima_amt_demo_key_phase3_sandbox_2026"

# AIMA_EVENTS — Events & Conferences
DEMO_EVENTS_API_KEY="aima_events_demo_key_phase3_sandbox_2026"
