# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, gateway return URLs, and webhook callbacks.
APP_URL="http://localhost:3000"

# SERVER_PORT: Port for Express server (defaults to 3000 in AI Studio)
PORT="3000"

# ==============================================================================
# WORLDLINE / PAYNIMO SANDBOX CONFIGURATION
# Reference: https://www.paynimo.com/paynimocheckout/docs/#online
# ==============================================================================
# Environment: Must be 'sandbox' (server strictly refuses 'production' in test mode)
WORLDLINE_ENVIRONMENT="sandbox"

# Merchant Code supplied in AIMA test kit
WORLDLINE_MERCHANT_CODE="T945221"

# Scheme Code supplied in AIMA test kit (maps to item.itemId)
WORLDLINE_SCHEME_CODE="FIRST"

# Worldline Secret Salt for SHA-256 token generation and dual verification
# (Provided by Worldline integration team; never expose to frontend or git)
WORLDLINE_SALT="YOUR_WORLDLINE_SANDBOX_SALT"

# ==============================================================================
# CCAVENUE / HDFC SANDBOX CONFIGURATION
# Note: The supplied correspondence contains LIVE production keys (TID 76098022,
# ACCT ID 4168947, secure.ccavenue.com), which cannot be used for sandbox.
# Acquire test credentials from test.ccavenue.com before configuring below.
# ==============================================================================
CCAVENUE_ENVIRONMENT="sandbox"
CCAVENUE_MERCHANT_ID="YOUR_CCAVENUE_TEST_MERCHANT_ID"
CCAVENUE_ACCESS_CODE="YOUR_CCAVENUE_TEST_ACCESS_CODE"
CCAVENUE_WORKING_KEY="YOUR_CCAVENUE_TEST_WORKING_KEY"
